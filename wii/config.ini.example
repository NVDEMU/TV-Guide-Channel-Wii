# Copy this file to sd:/apps/tv-guide-channel-wii/config.ini
# Change server= to the LAN IPv4 address of a computer running the backend.
# Leave the example value unchanged to use the built-in guide snapshot instead.
# Optional static guide files may be copied beside boot.dol:
# guide-eastern.txt, guide-central.txt, guide-mountain.txt, guide-pacific.txt
# The channel uses HTTP only for trusted local-network development.
server=192.168.1.2
port=8000
timezone=America/New_York
