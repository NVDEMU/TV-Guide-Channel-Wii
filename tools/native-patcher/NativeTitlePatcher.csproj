<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="libWiiSharp">
      <HintPath>$(WADPAKK_DIR)/libWiiSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="../../translations/native-english-messages.json" Link="native-english-messages.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
